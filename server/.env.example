PORT=5000

# Neon (Postgres) — строка подключения. Пока пусто — сервер работает в dev-режиме
# с in-memory хранилищем (данные не сохраняются). Заполни для production.
DATABASE_URL=

# Панель 3x-ui. Пока PANEL_URL пуст — ключи генерируются в mock-режиме (заглушка).
# Заполни, когда дашь доступ к панели.
PANEL_URL=
PANEL_USERNAME=
PANEL_PASSWORD=
INBOUND_ID=4

# Хост/IP VPN-сервера в ссылке vless://. Если пусто — берётся hostname из PANEL_URL.
VPN_SERVER_HOST=

# Срок действия демо-ключа в минутах (по умолчанию 2 часа)
DEMO_TTL_MINUTES=120

# Токен панели (опционально, если настроен Bearer вместо логина/пароля)
PANEL_API_TOKEN=